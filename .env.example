# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Google Cloud SQL (PostgreSQL) - Configuración de Base de Datos
# ==========================================
# Host o IP pública de la instancia Cloud SQL
SQL_HOST="34.175.144.94"

# Puerto estándar de PostgreSQL
SQL_PORT="5432"

# Nombre de la base de datos (ej: postgres)
SQL_DB_NAME="postgres"

# Usuario de la base de datos (ej: postgres)
SQL_USER="postgres"

# Contraseña de la base de datos
SQL_PASSWORD="YOUR_DATABASE_PASSWORD"

# Usuario administrativo para migraciones Drizzle Kit
SQL_ADMIN_USER="postgres"

# Contraseña administrativa
SQL_ADMIN_PASSWORD="YOUR_DATABASE_PASSWORD"

# Requerir SSL para la conexión ('true' o 'false')
SQL_SSL="false"
