# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Cadena de conexión de PostgreSQL en Neon (Console > Connection details).
# Si NO se define, la app guarda los datos en data/tlm_database.json.
# Ejemplo: postgresql://USUARIO:CLAVE@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="MY_NEON_CONNECTION_STRING"

# ADMIN_PASSWORD / ADMIN_EMAIL: solo en producción. Crean el administrador inicial en la primera ejecución
# (la base de datos vacía). ADMIN_PASSWORD es obligatoria en producción, mínimo 8 caracteres.
ADMIN_EMAIL="automatizaciones@tlm.net.co"
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"

# SESSION_SECRET: Cadena larga y aleatoria para firmar las sesiones. OBLIGATORIA en producción.
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="MY_RANDOM_SECRET"

# Correo SMTP para enviar códigos de recuperación y contraseñas provisionales.
# Sirve cualquier proveedor SMTP (Gmail, Microsoft 365, Resend, SendGrid...).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="MY_SMTP_USER"
SMTP_PASS="MY_SMTP_PASSWORD"
SMTP_FROM="Consola TLM <no-reply@tlm.net.co>"

# TRUST_PROXY: pon "true" si la app está detrás de un proxy o balanceador, para limitar intentos por IP real.
TRUST_PROXY="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
