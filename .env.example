# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Neon Serverless PostgreSQL - Conector Único Oficial
# ==========================================
# ID del proyecto y branch en Neon Console
NEON_PROJECT_ID="bitter-frost-14568057"
NEON_BRANCH_ID="br-tiny-boat-b4jd4u1z"
NEON_ENDPOINT_ID="ep-rough-term-b4jl3vvr"

# Host oficial de Neon (us-east-2 AWS)
SQL_HOST="ep-rough-term-b4jl3vvr-pooler.c-6.us-east-2.aws.neon.tech"

# Puerto estándar de PostgreSQL
SQL_PORT="5432"

# Nombre de la base de datos
SQL_DB_NAME="neondb"

# Usuario propietario de la base de datos
SQL_USER="neondb_owner"

# Contraseña de Neon
SQL_PASSWORD="YOUR_NEON_PASSWORD"

# Usuario administrativo para Drizzle ORM
SQL_ADMIN_USER="neondb_owner"
SQL_ADMIN_PASSWORD="YOUR_NEON_PASSWORD"

# Conexión cifrada SSL obligatoria en Neon
SQL_SSL="true"

# URI directa de conexión PostgreSQL a Neon
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-rough-term-b4jl3vvr-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
