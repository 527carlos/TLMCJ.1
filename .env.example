# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Supabase PostgreSQL - Entornos de Prueba & Producción
# ==========================================
# ID del proyecto en Supabase (ej: fqatuwzsunvxbtryhloy)
SUPABASE_PROJECT_ID="fqatuwzsunvxbtryhloy"

# Host directo de la base de datos Supabase
SQL_HOST="db.fqatuwzsunvxbtryhloy.supabase.co"

# Puerto estándar de PostgreSQL
SQL_PORT="5432"

# Nombre de la base de datos (por defecto 'postgres')
SQL_DB_NAME="postgres"

# Usuario administrador de la base de datos (por defecto 'postgres')
SQL_USER="postgres"

# Contraseña de la base de datos Supabase
SQL_PASSWORD="YOUR_SUPABASE_DATABASE_PASSWORD"

# Usuario administrativo para migraciones Drizzle Kit
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="YOUR_SUPABASE_DATABASE_PASSWORD"

# Supabase REQUIERE conexión cifrada SSL ('true')
SQL_SSL="true"

# URI directa de conexión PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.fqatuwzsunvxbtryhloy.supabase.co:5432/postgres?sslmode=require"

# ==========================================
# Instancia Alternativa: Google Cloud SQL
# ==========================================
GCP_SQL_HOST="34.175.144.94"
GCP_SQL_PORT="5432"
GCP_SQL_DB_NAME="postgres"
GCP_SQL_USER="postgres"
GCP_SQL_PASSWORD="YOUR_GCP_PASSWORD"
GCP_SQL_SSL="false"
